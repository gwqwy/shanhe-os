#!/bin/sh
# 0020：部署「卅语工作室」原生 IDE —— 权限、关联、桌面入口。
# 编辑器主体与语法定义由 includes.chroot 原样带入，这里只做注册与收尾。
set -e

echo "-- 工作室：修复执行权限（构建宿主的文件系统可能丢失权限位）"
chmod 755 /opt/shanhe-studio/shanhe-studio.py 2>/dev/null || true
chmod 755 /usr/local/bin/sahou-studio \
          /usr/local/bin/shanhe-wine-assistant \
          /usr/local/bin/shanhe-help \
          /usr/local/lib/shanhe/nvidia-install.sh 2>/dev/null || true
chmod 755 /etc/skel/.config/autostart-scripts/*.sh 2>/dev/null || true
chmod 755 /etc/skel/.xinputrc 2>/dev/null || true

echo "-- 工作室：中文命令名「卅语工作室」"
ln -sf /usr/local/bin/sahou-studio "/usr/local/bin/卅语工作室"

echo "-- 工作室：检查 GtkSourceView 卅语语法定义"
test -f /usr/share/gtksourceview-4/language-specs/sahou.lang \
    && echo "   sahou.lang 已就位" || echo "   !! 缺少 sahou.lang"

echo "-- 工作室：默认应用关联（.saho → 工作室；.exe → Wine）"
mkdir -p /etc/xdg
cat > /etc/xdg/mimeapps.list <<'EOF'
[Default Applications]
text/x-saho=shanhe-studio.desktop
text/plain=org.kde.kate.desktop
application/x-ms-dos-executable=wine.desktop
EOF

echo "-- 工作室：刷新桌面与 MIME 数据库"
update-desktop-database /usr/share/applications 2>/dev/null || true
update-mime-database /usr/share/mime 2>/dev/null || true
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
